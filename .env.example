# ─── Genel ────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Europe/Istanbul

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sla_platform
POSTGRES_PORT=5432

# Migration / worker (cross-tenant, RLS bypass eden yonetici baglantisi)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/sla_platform
# API baglantisi: RLS zorunlu, dusuk yetkili rol (migration otomatik olusturur)
DATABASE_URL=postgres://app_user:app_user_pw@localhost:5432/sla_platform
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_pw

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ─── Auth ─────────────────────────────────────────────────────────────────
# Uretimde mutlaka degistir:  openssl rand -hex 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-fedcba9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

# ─── API ──────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300

# ─── SLA motoru ───────────────────────────────────────────────────────────
SLA_SCAN_INTERVAL_MS=60000
SLA_RISK_THRESHOLD=0.8

# ─── SMTP (compose icinde Mailpit) ────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SLA Platform <no-reply@slaplatform.local>"

# ─── Seed ─────────────────────────────────────────────────────────────────
SEED_PASSWORD=Passw0rd!
